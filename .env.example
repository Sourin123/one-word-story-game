# Server-side AI provider keys, read by the /api/ai Netlify Function.
# Set these in Netlify (Project configuration > Environment variables) — never commit real values.
# Do NOT prefix with VITE_: Vite embeds VITE_* variables into the public browser bundle.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROK_API_KEY=
